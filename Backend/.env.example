# Safe development defaults. Put real values only in a local .env or host secret store.
ENVIRONMENT=development
LOG_LEVEL=INFO
ENABLE_DOCS=true
# JSON list, e.g. CORS_ORIGINS=["http://localhost:3000"]
CORS_ORIGINS=[]

# Extraction is off by default. Turn it on locally only; production needs auth first.
EXTRACTION_ENABLED=false
# OPENROUTER_API_KEY=
# LLM_MODEL=qwen/qwen2.5-vl-72b-instruct
# MAX_UPLOAD_BYTES=10485760
# MAX_PAGES=5

# Only needed on Windows hosts where Tesseract/Poppler are not on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# POPPLER_PATH=C:\poppler-24.08.0\Library\bin

# Required in later milestones when those integrations are activated.
# DATABASE_URL=
# REDIS_URL=
# R2_ENDPOINT_URL=
# R2_BUCKET_NAME=
